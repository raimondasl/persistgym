diff --git a/tests/unit/test_exit_reason_run_meta.py b/tests/unit/test_exit_reason_run_meta.py
new file mode 100644
index 0000000..814dbe9
--- /dev/null
+++ b/tests/unit/test_exit_reason_run_meta.py
@@ -0,0 +1,216 @@
+"""run_meta.json records why each run ended."""
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+import numpy as np
+import pytest
+from arcengine import FrameDataRaw, GameAction, GameState
+from requests import HTTPError
+
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.base import ExitReason
+from benchmarking.runtime_models import ModelResponse, NormalizedUsage
+from benchmarking.swarm import Swarm
+
+CONFIG_ID = "openai-gpt-5-4-2026-03-05-responses"
+
+
+def _raw_frame(state: GameState, levels_completed: int = 0) -> FrameDataRaw:
+    raw = FrameDataRaw()
+    raw.game_id = "game-id"
+    raw.frame = [np.array([[0, 1], [1, 0]], dtype=np.int8)]
+    raw.state = state
+    raw.levels_completed = levels_completed
+    raw.win_levels = 1
+    raw.action_input = None
+    raw.guid = "guid-1"
+    raw.full_reset = False
+    raw.available_actions = [GameAction.ACTION1.value]
+    return raw
+
+
+class _ScriptedEnv:
+    """Minimal ARC environment: returns `next_state` after every step."""
+
+    def __init__(
+        self,
+        next_state: GameState = GameState.NOT_FINISHED,
+        *,
+        baseline_actions: list[int] | None = None,
+        step_error: Exception | None = None,
+    ) -> None:
+        self.info = SimpleNamespace(baseline_actions=baseline_actions or [])
+        self.observation_space = _raw_frame(GameState.NOT_FINISHED)
+        self.next_state = next_state
+        self.step_error = step_error
+        self.steps = 0
+
+    def step(self, action: GameAction, *, data: dict, reasoning: dict) -> FrameDataRaw:
+        if self.step_error is not None:
+            raise self.step_error
+        self.steps += 1
+        self.observation_space = _raw_frame(self.next_state)
+        return self.observation_space
+
+
+class _ActionAdapter:
+    def __init__(self, error: Exception | None = None) -> None:
+        self.error = error
+        self.calls = 0
+
+    def invoke(self, request: object) -> ModelResponse:
+        self.calls += 1
+        if self.error is not None:
+            raise self.error
+        return ModelResponse(
+            output_text="ACTION1",
+            usage=NormalizedUsage(input_tokens=3, output_tokens=2, total_tokens=5),
+        )
+
+
+def _agent(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+    env: _ScriptedEnv,
+    adapter: _ActionAdapter | None = None,
+) -> BenchmarkingAgent:
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: object()
+    )
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_adapter",
+        lambda **_kwargs: adapter or _ActionAdapter(),
+    )
+    return BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=env,
+        config=CONFIG_ID,
+    )
+
+
+def _run_meta(agent: BenchmarkingAgent) -> dict:
+    return json.loads((Path(agent.run_dir) / "run_meta.json").read_text())
+
+
+def _http_error(status_code: int) -> HTTPError:
+    return HTTPError(response=SimpleNamespace(status_code=status_code))
+
+
+def _swarm_for(agents: list[BenchmarkingAgent], close_error: HTTPError) -> Swarm:
+    with patch("benchmarking.swarm.Arcade"):
+        swarm = Swarm(ROOT_URL="https://example.com", games=["game-id"])
+    swarm.agents = list(agents)
+    swarm._arc.close_scorecard = Mock(side_effect=close_error)
+    return swarm
+
+
+@pytest.mark.unit
+class TestRunMetaExitReason:
+    def test_new_run_is_recorded_as_unknown_until_it_ends(self, monkeypatch, tmp_path):
+        agent = _agent(monkeypatch, tmp_path, _ScriptedEnv())
+
+        meta = _run_meta(agent)
+
+        assert meta["exit_reason"] == "UNKNOWN"
+        assert meta["ended_at"] is None
+
+    def test_game_win_is_recorded(self, monkeypatch, tmp_path):
+        agent = _agent(monkeypatch, tmp_path, _ScriptedEnv(GameState.WIN))
+
+        agent.main()
+
+        meta = _run_meta(agent)
+        assert agent.exit_reason is ExitReason.GAME_WIN
+        assert meta["exit_reason"] == "GAME_WIN"
+        assert meta["outcome"] == "WIN"
+        assert meta["ended_at"] is not None
+
+    def test_per_level_action_budget_is_recorded(self, monkeypatch, tmp_path):
+        # Two levels, baseline 1 action x 5.0 multiplier = 5 actions per level.
+        env = _ScriptedEnv(baseline_actions=[1, 1])
+        agent = _agent(monkeypatch, tmp_path, env)
+
+        agent.main()
+
+        meta = _run_meta(agent)
+        assert env.steps == 5
+        assert meta["exit_reason"] == "ACTION_BUDGET"
+        # The per-level budget ends the run before the total-action counter,
+        # so the legacy outcome field cannot tell this ending apart.
+        assert meta["outcome"] is None
+
+    def test_time_budget_is_recorded(self, monkeypatch, tmp_path):
+        env = _ScriptedEnv()
+        agent = _agent(monkeypatch, tmp_path, env)
+        agent.MAX_RUNTIME_SECONDS = 0
+
+        agent.main()
+
+        meta = _run_meta(agent)
+        assert env.steps == 0
+        assert meta["exit_reason"] == "TIME_BUDGET"
+        assert meta["outcome"] == "TIMEOUT"
+
+    def test_model_failure_is_recorded_as_agent_error_before_raising(
+        self, monkeypatch, tmp_path
+    ):
+        env = _ScriptedEnv()
+        adapter = _ActionAdapter(error=RuntimeError("model unavailable"))
+        agent = _agent(monkeypatch, tmp_path, env, adapter)
+
+        with pytest.raises(RuntimeError, match="Failed to get a valid action"):
+            agent.main()
+
+        meta = _run_meta(agent)
+        assert adapter.calls == agent.MAX_RETRIES + 1
+        assert env.steps == 0
+        assert meta["exit_reason"] == "AGENT_ERROR"
+
+    def test_arc_step_failure_is_recorded_as_api_error_before_raising(
+        self, monkeypatch, tmp_path
+    ):
+        env = _ScriptedEnv(step_error=RuntimeError("arc api down"))
+        agent = _agent(monkeypatch, tmp_path, env)
+
+        with pytest.raises(RuntimeError, match="arc api down"):
+            agent.main()
+
+        assert _run_meta(agent)["exit_reason"] == "API_ERROR"
+
+    def test_closed_scorecard_reclassification_is_persisted(self, monkeypatch, tmp_path):
+        env = _ScriptedEnv(step_error=RuntimeError("scorecard closed"))
+        agent = _agent(monkeypatch, tmp_path, env)
+        with pytest.raises(RuntimeError):
+            agent.main()
+        swarm = _swarm_for([agent], _http_error(404))
+
+        with patch.object(Swarm, "_scorecard_exists", return_value=True):
+            scorecard = swarm.close_scorecard("card-id")
+        swarm.cleanup(scorecard)
+
+        meta = _run_meta(agent)
+        assert agent.exit_reason is ExitReason.SCORECARD_CLOSED
+        assert meta["exit_reason"] == "SCORECARD_CLOSED"
+        assert meta["ended_at"] is not None
+
+    def test_swarm_revision_after_agent_cleanup_is_persisted(self, monkeypatch, tmp_path):
+        agent = _agent(monkeypatch, tmp_path, _ScriptedEnv(GameState.WIN))
+        agent.main()
+        assert _run_meta(agent)["exit_reason"] == "GAME_WIN"
+        swarm = _swarm_for([agent], _http_error(500))
+
+        scorecard = swarm.close_scorecard("card-id")
+        swarm.cleanup(scorecard)
+
+        # Upstream marks every agent API_ERROR when closing the scorecard fails;
+        # run_meta.json now reflects the final reason the swarm logs.
+        assert agent.exit_reason is ExitReason.API_ERROR
+        assert _run_meta(agent)["exit_reason"] == "API_ERROR"
