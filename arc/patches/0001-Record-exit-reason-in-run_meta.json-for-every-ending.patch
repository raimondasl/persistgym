From 0350a8164e1565121d57d30dd9c5c1657d7468ce Mon Sep 17 00:00:00 2001
From: Raimondas Lencevicius <59739769+raimondasl@users.noreply.github.com>
Date: Wed, 30 Sep 2026 23:26:29 -0400
Subject: [PATCH 01/18] Record exit reason in run_meta.json for every ending

ExitReason was only logged by Swarm, so run_meta.json could not tell a
per-level action budget from an error or a timeout: `outcome` stays null
when the per-level budget ends a run before the total action count.

- RunRecord gains `exit_reason`; `_write_run_meta` syncs it from the
  agent, so a new or interrupted run reads UNKNOWN.
- BenchmarkingAgent.main persists API_ERROR / AGENT_ERROR before the
  exception propagates (Agent.main re-raises without cleanup()).
- cleanup() rewrites run_meta.json when Swarm.close_scorecard revises the
  reason after the agent already cleaned up (SCORECARD_CLOSED, API_ERROR).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 benchmarking/agent.py                   |  16 ++
 benchmarking/recording.py               |   3 +
 docs/runtime-state.md                   |   6 +
 tests/unit/test_exit_reason_run_meta.py | 216 ++++++++++++++++++++++++
 4 files changed, 241 insertions(+)
 create mode 100644 tests/unit/test_exit_reason_run_meta.py

diff --git a/benchmarking/agent.py b/benchmarking/agent.py
index 7d6d1c3..989a04a 100644
--- a/benchmarking/agent.py
+++ b/benchmarking/agent.py
@@ -491,6 +491,9 @@ class BenchmarkingAgent(Agent):
         return str(action.name)
 
     def _write_run_meta(self) -> None:
+        self.run_record.exit_reason = ExitReason(
+            getattr(self, "exit_reason", ExitReason.UNKNOWN)
+        ).value
         path = os.path.join(self.run_dir, "run_meta.json")
         with open(path, "w") as f:
             exclude = {"runtime"} if self.run_record.runtime is None else None
@@ -720,6 +723,15 @@ class BenchmarkingAgent(Agent):
 
     # ── Core loop ────────────────────────────────────────────────────────
 
+    def main(self) -> None:
+        try:
+            super().main()
+        finally:
+            # Agent.main records API_ERROR or AGENT_ERROR and re-raises without
+            # calling cleanup(), so persist that ending before it propagates.
+            if hasattr(self, "run_record"):
+                self._write_run_meta()
+
     def _sync_level_progress(self, latest_frame: FrameData) -> None:
         current_level = latest_frame.levels_completed
         if current_level > self._last_levels_completed:
@@ -1168,4 +1180,8 @@ class BenchmarkingAgent(Agent):
                         "total_tokens": self.token_counter,
                     }
                 )
+        elif hasattr(self, "run_record"):
+            # Swarm.close_scorecard can revise exit_reason after this agent's
+            # own cleanup ran (SCORECARD_CLOSED, API_ERROR); keep the file in sync.
+            self._write_run_meta()
         super().cleanup(*args, **kwargs)
