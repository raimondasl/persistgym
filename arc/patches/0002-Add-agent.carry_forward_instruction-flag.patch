@@ -0,0 +1,187 @@
+"""agent.carry_forward_instruction removes the manual carry-forward sentence."""
+
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import yaml
+from arcengine import FrameData, GameAction, GameState
+
+import benchmarking.model_config as model_config
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.model_config import get_model_config
+from benchmarking.runtime_models import ModelRequest, ModelResponse, NormalizedUsage
+
+SENTENCE = (
+    "Include any context you want to carry forward in your reply, "
+    "along with the action you want to take."
+)
+# System prompts at 4ca00e6, before the flag existed.
+BASELINE_PROMPT = (
+    "You are playing a game. Your goal is to win. Include any context you want to "
+    "carry forward in your reply, along with the action you want to take. The final "
+    "action mentioned in your reply will be executed next turn.\n"
+)
+BASELINE_ANALYSIS_PROMPT = (
+    "You are playing a game. Your goal is to win. Include any context you want to "
+    "carry forward in your reply, along with the action you want to take. The final "
+    "action mentioned in your reply will be executed next turn.\n"
+    "\n"
+    "Prior assistant turns may include a <reasoning_summary> block before the prior "
+    "action text. Treat those summaries as compact helper context about the earlier "
+    "decision process, then continue by choosing the next action normally.\n"
+)
+CONTINUOUS_PROMPT = (
+    "You are playing a game. Your goal is to win. The final action mentioned in "
+    "your reply will be executed next turn.\n"
+)
+
+
+def _write_model_configs(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    configs: list[dict],
+) -> Path:
+    config_path = tmp_path / "model_configs.yaml"
+    config_path.write_text(yaml.safe_dump(configs, sort_keys=False))
+    monkeypatch.setattr(model_config, "MODEL_CONFIG_PATH", config_path)
+    return config_path
+
+
+class _FakeAdapter:
+    def __init__(self) -> None:
+        self.requests: list[ModelRequest] = []
+
+    def invoke(self, request: ModelRequest) -> ModelResponse:
+        self.requests.append(request)
+        return ModelResponse(output_text="ACTION1", usage=NormalizedUsage())
+
+
+def _prompt_agent(*, analysis_mode: bool, carry_forward: bool | None) -> BenchmarkingAgent:
+    agent = BenchmarkingAgent.__new__(BenchmarkingAgent)
+    agent.analysis_mode = analysis_mode
+    if carry_forward is not None:
+        agent.carry_forward_instruction = carry_forward
+    return agent
+
+
+def _config_agent(monkeypatch, tmp_path, agent_section: dict) -> BenchmarkingAgent:
+    config = deepcopy(get_model_config("openai-gpt-5-4-2026-03-05-responses"))
+    config["agent"].update(agent_section)
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("benchmarking.agent.get_model_config", lambda _id: config)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: object()
+    )
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_adapter",
+        lambda **_kwargs: _FakeAdapter(),
+    )
+    return BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=SimpleNamespace(info=SimpleNamespace(baseline_actions=[])),
+        config=config["id"],
+    )
+
+
+def _frame() -> FrameData:
+    return FrameData(
+        frame=[[[0, 1], [1, 0]]],
+        state=GameState.NOT_FINISHED,
+        levels_completed=0,
+        available_actions=[GameAction.ACTION1.value],
+    )
+
+
+@pytest.mark.unit
+class TestCarryForwardInstructionPrompt:
+    @pytest.mark.parametrize(
+        ("analysis_mode", "expected"),
+        [(False, BASELINE_PROMPT), (True, BASELINE_ANALYSIS_PROMPT)],
+    )
+    def test_default_prompts_are_unchanged(self, analysis_mode, expected):
+        for carry_forward in (None, True):
+            agent = _prompt_agent(analysis_mode=analysis_mode, carry_forward=carry_forward)
+
+            assert agent._build_system_prompt() == expected
+
+    def test_flag_off_matches_continuous_conversation_prompt(self):
+        agent = _prompt_agent(analysis_mode=False, carry_forward=False)
+
+        assert agent._build_system_prompt() == CONTINUOUS_PROMPT
+        assert SENTENCE not in agent._build_system_prompt()
+
+    def test_flag_off_wins_over_analysis_mode(self):
+        agent = _prompt_agent(analysis_mode=True, carry_forward=False)
+
+        prompt = agent._build_system_prompt()
+
+        assert SENTENCE not in prompt
+        assert "carry forward" not in prompt
+        assert prompt == BASELINE_ANALYSIS_PROMPT.replace(SENTENCE + " ", "")
+        assert "<reasoning_summary>" in prompt
+
+    def test_continuous_conversation_ignores_flag_default(self):
+        agent = _prompt_agent(analysis_mode=True, carry_forward=None)
+        agent._stateful_adapter = SimpleNamespace(provides_continuous_conversation=True)
+
+        assert agent._build_system_prompt() == CONTINUOUS_PROMPT
+
+
+@pytest.mark.unit
+class TestCarryForwardInstructionConfig:
+    def test_agent_reads_flag_and_sends_prompt_without_sentence(
+        self, monkeypatch, tmp_path
+    ):
+        agent = _config_agent(
+            monkeypatch,
+            tmp_path,
+            {"carry_forward_instruction": False, "analysis_mode": True},
+        )
+
+        agent.choose_action([], _frame())
+
+        assert agent.carry_forward_instruction is False
+        system_message = agent._adapter.requests[0].messages[0]
+        assert system_message.role == "system"
+        assert SENTENCE not in system_message.content
+        assert "carry forward" not in system_message.content
+
+    def test_agent_defaults_to_sending_sentence(self, monkeypatch, tmp_path):
+        agent = _config_agent(monkeypatch, tmp_path, {})
+
+        agent.choose_action([], _frame())
+
+        assert agent.carry_forward_instruction is True
+        assert agent._adapter.requests[0].messages[0].content == BASELINE_PROMPT
+
+    @pytest.mark.parametrize("value", ["false", 0, None])
+    def test_non_boolean_flag_is_rejected(self, tmp_path, monkeypatch, value):
+        entry = deepcopy(get_model_config("openai-gpt-5-4-2026-03-05-responses"))
+        entry["agent"]["carry_forward_instruction"] = value
+        _write_model_configs(tmp_path, monkeypatch, [entry])
+
+        with pytest.raises(ValueError, match="carry_forward_instruction must be a boolean"):
+            model_config.load_model_configs()
+
+    def test_continuous_conversation_rejects_flag_on(self, tmp_path, monkeypatch):
+        entry = deepcopy(get_model_config("google-gemini-3-8-flash-low-provider-adapter"))
+        entry["agent"]["carry_forward_instruction"] = True
+        _write_model_configs(tmp_path, monkeypatch, [entry])
+
+        with pytest.raises(ValueError, match="always omits the carry-forward"):
+            model_config.load_model_configs()
+
+    def test_continuous_conversation_accepts_flag_off(self, tmp_path, monkeypatch):
+        entry = deepcopy(get_model_config("google-gemini-3-8-flash-low-provider-adapter"))
+        entry["agent"]["carry_forward_instruction"] = False
+        _write_model_configs(tmp_path, monkeypatch, [entry])
+
+        configs = model_config.load_model_configs()
+
+        assert configs[0]["agent"]["carry_forward_instruction"] is False
