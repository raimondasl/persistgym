+@pytest.mark.unit
+@pytest.mark.filterwarnings("ignore:Interactions usage is experimental")
+class TestGoogleInteractionsServiceTier:
+    @pytest.mark.parametrize("tier", ["flex", "standard", "priority"])
+    def test_manual_rolling_request_sends_configured_tier(self, tier):
+        recorder = _Recorder(lambda turn: _interaction_json(turn, tier=tier))
+        client = _google_client(recorder)
+        try:
+            response = GoogleGenAIInteractionsAdapter(client).invoke(
+                _manual_request(_google_request_config(tier))
+            )
+        finally:
+            client.close()
+
+        assert recorder.bodies[0]["service_tier"] == tier
+        assert response.service_tier == tier
+
+    def test_unset_tier_is_not_sent(self):
+        recorder = _Recorder(lambda turn: _interaction_json(turn, tier=None))
+        client = _google_client(recorder)
+        try:
+            response = GoogleGenAIInteractionsAdapter(client).invoke(
+                _manual_request(_google_request_config(None))
+            )
+        finally:
+            client.close()
+
+        assert "service_tier" not in recorder.bodies[0]
+        assert response.service_tier is None
+
+    def test_continuous_conversation_and_summary_compaction_send_tier(self):
+        recorder = _Recorder(lambda turn: _interaction_json(turn, tier="flex"))
+        client = _google_client(recorder)
+        try:
+            adapter = GoogleContinuousConversationRuntimeAdapter(
+                model_adapter=GoogleGenAIInteractionsAdapter(client),
+                descriptor=ADAPTER_DESCRIPTORS["google.interactions.v1"],
+            )
+            first = adapter.invoke_turn(
+                ModelTurnRequest(
+                    system_prompt="system",
+                    new_messages=[Message(role="user", content="one")],
+                    request_config=_google_request_config("flex"),
+                    previous_state=adapter.initial_state(),
+                )
+            )
+            compactor = SummaryCompactor(
+                SummaryCompactionPolicy(
+                    strategy="harness_summary", trigger_tokens=175_000
+                )
+            )
+            compactor.compact(
+                adapter=adapter,
+                state=first.state,
+                request_config=_google_request_config("flex"),
+                trigger_tokens=175_000,
+                max_context_length=1_048_576,
+                max_retries=0,
+            )
+        finally:
+            client.close()
+
+        action_body, summary_body = recorder.bodies
+        assert action_body["service_tier"] == "flex"
+        assert summary_body["service_tier"] == "flex"
+        assert summary_body["generation_config"]["max_output_tokens"] == 8_192
+        assert first.response.service_tier == "flex"
+
