+            client.close()
+
+        assert [body["service_tier"] for body in recorder.bodies] == ["flex", "flex"]
+        assert result.response.service_tier == "flex"
+
+    def test_chat_completions_request_sends_tier(self):
+        recorder = _Recorder(lambda turn: _chat_json(turn, tier="flex"))
+        client = _openai_client(recorder)
+        try:
+            response = OpenAIChatCompletionsAdapter(client).invoke(
+                _manual_request({"model": "gpt-test", "service_tier": "flex"})
+            )
+        finally:
+            client.close()
+
+        assert recorder.bodies[0]["service_tier"] == "flex"
+        assert response.service_tier == "flex"
+
+
+class _TierAdapter:
+    def __init__(self, reported: str | None) -> None:
+        self.reported = reported
+
+    def invoke(self, request: ModelRequest) -> ModelResponse:
+        return ModelResponse(
+            output_text="ACTION1",
+            usage=NormalizedUsage(total_tokens=5),
+            service_tier=self.reported,
+        )
+
+
+def _agent(monkeypatch, tmp_path, *, requested: str | None, reported: str | None):
+    config = deepcopy(get_model_config("openai-gpt-5-4-2026-03-05-responses"))
+    if requested is not None:
+        config["request"]["service_tier"] = requested
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("benchmarking.agent.get_model_config", lambda _id: config)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: object()
+    )
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_adapter",
+        lambda **_kwargs: _TierAdapter(reported),
+    )
+    return BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=SimpleNamespace(info=SimpleNamespace(baseline_actions=[])),
+        config=config["id"],
+    )
+
+
+def _frame() -> FrameData:
+    return FrameData(
+        frame=[[[0, 1], [1, 0]]],
+        state=GameState.NOT_FINISHED,
+        levels_completed=0,
+        available_actions=[GameAction.ACTION1.value],
+    )
+
+
+@pytest.mark.unit
+class TestAgentServiceTierRecording:
+    def test_requested_and_reported_tiers_are_recorded(self, monkeypatch, tmp_path):
+        agent = _agent(monkeypatch, tmp_path, requested="flex", reported="flex")
+
+        agent.choose_action([], _frame())
