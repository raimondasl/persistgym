+def _write_model_configs(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    configs: list[dict],
+) -> Path:
+    config_path = tmp_path / "model_configs.yaml"
+    config_path.write_text(yaml.safe_dump(configs, sort_keys=False))
+    monkeypatch.setattr(model_config, "MODEL_CONFIG_PATH", config_path)
+    return config_path
+
+
+def _with_tier(config_id: str, tier: object, **runtime: str) -> dict:
+    entry = deepcopy(get_model_config(config_id))
+    entry["runtime"].update(runtime)
+    entry["request"]["service_tier"] = tier
+    return entry
+
+
+class _Recorder:
+    """httpx handler that records JSON bodies and returns canned responses."""
+
+    def __init__(self, respond) -> None:  # noqa: ANN001
+        self.respond = respond
+        self.bodies: list[dict] = []
+
+    def __call__(self, request: httpx.Request) -> httpx.Response:
+        self.bodies.append(json.loads(request.content))
+        return httpx.Response(200, request=request, json=self.respond(len(self.bodies)))
+
+
