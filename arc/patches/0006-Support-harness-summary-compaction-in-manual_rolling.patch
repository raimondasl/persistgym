+"""Harness summary compaction for the manual_rolling (visible-text) transcript."""
+
+import json
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import yaml
+from arcengine import FrameDataRaw, GameAction, GameState
+
+import benchmarking.model_config as model_config
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.base import ExitReason
+from benchmarking.compaction import (
+    MANUAL_ROLLING_SUMMARY_ADAPTER_ID,
+    SUMMARY_REQUEST_PROMPT,
+    SUMMARY_SYSTEM_PROMPT,
+    ManualRollingSummaryAdapter,
+    SummaryCompactionPolicy,
+    SummaryCompactor,
+    build_summary_bridge,
+)
+from benchmarking.exceptions import ContextOverflowError
+from benchmarking.runtime_models import (
+    Message,
+    ModelRequest,
+    ModelResponse,
+    NormalizedUsage,
+)
+from benchmarking.runtime_state import ModelTurnRequest, SummaryCompactionRuntimeAdapter
+
+pytestmark = pytest.mark.unit
+
+SYSTEM = "system prompt"
+POLICY = {
+    "strategy": "harness_summary",
+    "trigger_tokens": 1_000,
+    "summary_max_output_tokens": 64,
+    "summary_input_headroom_tokens": 64,
+}
+
+
+def _config(**agent: object) -> dict:
+    config = {
+        "id": "rolling-summary-test",
+        "agent": {"MAX_CONTEXT_LENGTH": 100_000, **agent},
+        "runtime": {
+            "sdk": "openai-python",
+            "api": "chat_completions",
+            "state": "manual_rolling",
+            "compaction": dict(POLICY),
+        },
+        "client": {"api_key_env": "OPENAI_API_KEY"},
+        "request": {"model": "test-model", "max_completion_tokens": 512},
+        "pricing": {"input": 1.0, "output": 2.0},
+    }
+    return config
+
+
+def _usage(total: int) -> NormalizedUsage:
+    return NormalizedUsage(
+        input_tokens=total - 10, output_tokens=10, total_tokens=total
+    )
+
+
+class _ScriptedAdapter:
+    """Plain adapter: numbered notes for actions, numbered summaries otherwise."""
+
+    def __init__(
+        self,
+        total_tokens: dict[int, int] | None = None,
+        overflow_calls: set[int] | None = None,
+        unparseable_calls: set[int] | None = None,
+    ) -> None:
+        self.total_tokens = total_tokens or {}
+        self.overflow_calls = overflow_calls or set()
+        self.unparseable_calls = unparseable_calls or set()
+        self.requests: list[ModelRequest] = []
+        self.action_calls = 0
+        self.action_turns = 0
+        self.summaries = 0
+
+    def invoke(self, request: ModelRequest) -> ModelResponse:
+        self.requests.append(deepcopy(request))
+        if request.messages[0].content == SUMMARY_SYSTEM_PROMPT:
+            self.summaries += 1
+            return ModelResponse(
+                output_text=f"summary {self.summaries}", usage=_usage(300)
+            )
+        self.action_calls += 1
+        if self.action_calls in self.overflow_calls:
+            raise ContextOverflowError("input token count exceeds the maximum")
+        if self.action_calls in self.unparseable_calls:
+            return ModelResponse(output_text="no action", usage=_usage(600))
+        self.action_turns += 1
+        turn = self.action_turns
+        return ModelResponse(
+            output_text=f"note {turn}: ACTION1",
+            reasoning_text=f"thinking {turn}",
+            usage=_usage(self.total_tokens.get(turn, 100)),
+        )
+
+
+def _raw_frame(value: int, state: GameState = GameState.NOT_FINISHED) -> FrameDataRaw:
+    raw = FrameDataRaw()
+    raw.game_id = "game-id"
+    raw.frame = [np.array([[value, 0], [0, value]], dtype=np.int8)]
+    raw.state = state
+    raw.levels_completed = 0
+    raw.win_levels = 1
+    raw.action_input = None
+    raw.guid = "guid-1"
+    raw.full_reset = False
+    raw.available_actions = [GameAction.ACTION1.value]
+    return raw
+
+
+class _Game:
+    """Frame n follows the n-th action; ``game_over_after`` ends a life once."""
+
+    def __init__(self, game_over_after: int | None = None) -> None:
+        self.info = SimpleNamespace(baseline_actions=[])
+        self.observation_space = _raw_frame(1)
+        self.actions: list[GameAction] = []
+        self.game_over_after = game_over_after
+
+    def step(self, action: GameAction, *, data: dict, reasoning: dict) -> FrameDataRaw:
+        self.actions.append(action)
+        value = len(self.actions) + 1
+        state = GameState.NOT_FINISHED
+        if action is GameAction.ACTION1 and len(self.actions) == self.game_over_after:
+            state = GameState.GAME_OVER
+        self.observation_space = _raw_frame(value, state)
+        return self.observation_space
+
+
+def _agent(monkeypatch, tmp_path, config, adapter, game) -> BenchmarkingAgent:
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("benchmarking.agent.get_model_config", lambda _id: config)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: object()
+    )
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_adapter", lambda **_kwargs: adapter
+    )
+    agent = BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=game,
+        config=config["id"],
+    )
+    agent._build_system_prompt = lambda: SYSTEM  # type: ignore[method-assign]
+    return agent
+
+
+def _play(monkeypatch, tmp_path, *, actions, adapter, config=None, game=None):
+    game = game or _Game()
+    agent = _agent(monkeypatch, tmp_path, config or _config(), adapter, game)
+    agent._level_action_budgets = [actions]
+    agent.main()
+    return agent, game
+
+
+def _messages(request: ModelRequest) -> list[tuple[str, str]]:
+    return [(message.role, message.content) for message in request.messages]
+
+
+def _obs(agent_or_value) -> str:
+    value = agent_or_value
+    actions = "- ACTION1" if value == 1 else "- RESET\n- ACTION1"
+    return (
+        "State: NOT_FINISHED\nLevels completed: 0\n\n"
+        f"Frame 0:\n  [{value}, 0]\n  [0, {value}]\n\n"
+        f"Available actions:\n{actions}"
+    )
+
+
+def _read(agent: BenchmarkingAgent, name: str) -> dict:
+    return json.loads((Path(agent.run_dir) / name).read_text())
+
+
