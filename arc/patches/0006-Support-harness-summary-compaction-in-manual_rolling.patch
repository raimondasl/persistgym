+class TestManualRollingSummaryAdapter:
+    def test_satisfies_the_summary_compaction_contract(self):
+        adapter = ManualRollingSummaryAdapter(model_adapter=_ScriptedAdapter())
+
+        assert isinstance(adapter, SummaryCompactionRuntimeAdapter)
+        assert adapter.provides_continuous_conversation is False
+        assert adapter.initial_state().adapter_id == MANUAL_ROLLING_SUMMARY_ADAPTER_ID
+        assert adapter.initial_state().strategy == "manual_rolling"
+
+    def test_turns_are_user_assistant_pairs_and_buffered_inputs_are_gaps(self):
+        adapter = ManualRollingSummaryAdapter(model_adapter=_ScriptedAdapter())
+        messages = [
+            {"role": "user", "content": "bridge"},
+            {"role": "user", "content": "obs 1"},
+            {"role": "assistant", "content": "out 1"},
+            {"role": "user", "content": "game over"},
+            {"role": "user", "content": "obs 2"},
+            {"role": "assistant", "content": "out 2"},
+        ]
+
+        state = adapter.state_from_messages(messages)
+
+        assert [(t.start_item, t.end_item) for t in state.accepted_turns] == [
+            (1, 3),
+            (4, 6),
+        ]
+        assert adapter.messages_from_state(state) == messages
+
+    def test_invoke_turn_sends_visible_text_through_the_plain_adapter(self):
+        plain = _ScriptedAdapter()
+        adapter = ManualRollingSummaryAdapter(model_adapter=plain)
+        state = adapter.state_from_messages(
+            [{"role": "user", "content": "obs 1"}, {"role": "assistant", "content": "out 1"}]
+        )
+
+        result = adapter.invoke_turn(
+            ModelTurnRequest(
+                system_prompt=SUMMARY_SYSTEM_PROMPT,
+                new_messages=[Message(role="user", content=SUMMARY_REQUEST_PROMPT)],
+                request_config={"model": "m", "max_output_tokens": 64},
+                previous_state=state,
+            )
+        )
+
+        assert _messages(plain.requests[0]) == [
+            ("system", SUMMARY_SYSTEM_PROMPT),
+            ("user", "obs 1"),
+            ("assistant", "out 1"),
+            ("user", SUMMARY_REQUEST_PROMPT),
+        ]
+        assert plain.requests[0].native_input is None
+        assert result.response.output_text == "summary 1"
+        assert len(result.state.accepted_turns) == 2
+
+    def test_summary_overflow_unwinds_and_restores_the_latest_turn(self):
+        class _OverflowOnce(_ScriptedAdapter):
+            def invoke(self, request: ModelRequest) -> ModelResponse:
+                if not self.requests:
+                    self.requests.append(deepcopy(request))
+                    raise ContextOverflowError("too many tokens")
+                return super().invoke(request)
+
+        plain = _OverflowOnce()
+        adapter = ManualRollingSummaryAdapter(model_adapter=plain)
+        messages = [
+            {"role": "user", "content": "obs 1"},
+            {"role": "assistant", "content": "out 1"},
+            {"role": "user", "content": "obs 2"},
+            {"role": "assistant", "content": "out 2"},
+        ]
+
+        result = SummaryCompactor(SummaryCompactionPolicy(**POLICY)).compact(
+            adapter=adapter,
+            state=adapter.state_from_messages(messages),
+            request_config={"model": "m"},
+            trigger_tokens=1_000,
+            max_context_length=100_000,
+            max_retries=1,
+        )
+
+        assert _messages(plain.requests[1])[1:3] == [("user", "obs 1"), ("assistant", "out 1")]
+        assert adapter.messages_from_state(result.state) == [
+            {"role": "user", "content": build_summary_bridge("summary 1")},
+            *messages[2:],
+        ]
+        assert result.excluded_turns == 1
+        assert result.overflow_recoveries == 1
+
