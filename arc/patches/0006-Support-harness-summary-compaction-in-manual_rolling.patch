+class ManualRollingSummaryAdapter:
+    """Present a ``manual_rolling`` transcript to ``SummaryCompactor``.
+
+    The state payload holds the normalized messages after the system prompt.
+    An accepted turn is a user message immediately followed by its assistant
+    reply. Any other user message, such as a buffered GAME_OVER observation or
+    a summary bridge, sits between turns, as buffered inputs do in the Google
+    continuous-conversation adapter. Requests carry visible text only and go
+    through the configured plain model adapter, so a summary request has the
+    same API surface and settings as an action request.
+    """
+
+    strategy = DEFAULT_RUNTIME_STATE
+    provides_continuous_conversation = False
+
+    def __init__(self, *, model_adapter: Any) -> None:
+        self._model_adapter = model_adapter
+        self.descriptor = AdapterDescriptor(
+            adapter_id=MANUAL_ROLLING_SUMMARY_ADAPTER_ID,
+            provider="any",
+            api_surface="normalized messages",
+            implementation_path="benchmarking/compaction.py",
+            version="1",
+            approval_status="harness",
+        )
+
+    def initial_state(self) -> RuntimeState:
+        return RuntimeState(
+            adapter_id=self.descriptor.adapter_id,
+            strategy=self.strategy,
+            payload={"messages": []},
+        )
+
+    def state_from_messages(self, messages: list[dict[str, Any]]) -> RuntimeState:
+        """Build a state from transcript messages that follow the system prompt."""
+        items = [Message.model_validate(message).model_dump() for message in messages]
+        turns = [
+            AcceptedTurn(
+                start_item=index,
+                end_item=index + 2,
+                messages=[
+                    Message.model_validate(items[index]),
+                    Message.model_validate(items[index + 1]),
+                ],
+            )
+            for index in range(len(items) - 1)
+            if items[index]["role"] == "user"
+            and items[index + 1]["role"] == "assistant"
+        ]
+        return RuntimeState(
+            adapter_id=self.descriptor.adapter_id,
+            strategy=self.strategy,
+            payload={"messages": items},
+            accepted_turns=turns,
+        )
+
+    @staticmethod
+    def messages_from_state(state: RuntimeState) -> list[dict[str, Any]]:
+        return [dict(item) for item in runtime_payload_items(state, "messages")]
+
+    def buffer_inputs(
+        self, state: RuntimeState, messages: list[Message]
+    ) -> RuntimeState:
+        state.validate_for(
+            adapter_id=self.descriptor.adapter_id, strategy=self.strategy
+        )
+        items = runtime_payload_items(state, "messages")
+        items.extend(message.model_dump() for message in messages)
+        return replace_runtime_payload(state, {"messages": items})
+
+    def invoke_turn(self, request: ModelTurnRequest) -> ModelTurnResult:
+        request.previous_state.validate_for(
+            adapter_id=self.descriptor.adapter_id, strategy=self.strategy
+        )
+        previous = runtime_payload_items(request.previous_state, "messages")
+        sent = [*previous, *(message.model_dump() for message in request.new_messages)]
+        model_request = ModelRequest(
+            messages=[
+                Message(role="system", content=request.system_prompt),
+                *(Message.model_validate(message) for message in sent),
+            ],
+            request_config=dict(request.request_config),
+        )
+        response = self._model_adapter.invoke(model_request)
+        next_items = [*sent, {"role": "assistant", "content": response.output_text}]
+        return ModelTurnResult(
+            response=response,
+            state=append_accepted_turn(
+                state=request.previous_state,
+                payload={"messages": next_items},
+                start_item=len(previous),
+                end_item=len(next_items),
+                request_messages=request.new_messages,
+                response=response,
+            ),
+            sanitized_request={
+                "messages": [message.model_dump() for message in model_request.messages],
+                "settings": sanitize_settings(request.request_config),
+            },
+            transition=StateTransitionTelemetry(
+                input_items_sent=len(sent),
+                history_items_before_prune=len(next_items),
+                history_items_after_prune=len(next_items),
+            ),
+        )
+
+    def unwind_latest_accepted_turn(
+        self, state: RuntimeState
+    ) -> CompactionUnwindResult | None:
+        state.validate_for(
+            adapter_id=self.descriptor.adapter_id, strategy=self.strategy
+        )
+        return unwind_runtime_state_items(state, payload_key="messages")
+
+    def rebuild_after_compaction(
+        self,
+        summary_message: Message,
+        retained_turns: list[CompactionUnwindResult],
+    ) -> RuntimeState:
+        return restore_unwound_runtime_state_items(
+            self.buffer_inputs(self.initial_state(), [summary_message]),
+            payload_key="messages",
+            retained_turns=retained_turns,
+        )
+
+
 class SummaryCompactor:
     TRANSIENT_RETRY_BASE_SECONDS = 0.25
 
