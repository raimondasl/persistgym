@@ -0,0 +1,109 @@
+"""Gemini 3.8 Flash high profiles between Standard and the Provider Adapter.
+
+The path changes one harness setting at a time:
+Standard -> rolling-summary (loss policy) -> rolling-summary-notes-off
+(carry-forward instruction) -> Provider Adapter (native replay).
+"""
+
+import json
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.compaction import ManualRollingSummaryAdapter
+from benchmarking.model_config import get_model_config
+
+STANDARD = "google-gemini-3-8-flash-high"
+ROLLING_SUMMARY = "google-gemini-3-8-flash-high-rolling-summary"
+NOTES_OFF = "google-gemini-3-8-flash-high-rolling-summary-notes-off"
+PROVIDER_ADAPTER = "google-gemini-3-8-flash-high-provider-adapter"
+CARRY_FORWARD = (
+    "Include any context you want to carry forward in your reply, "
+    "along with the action you want to take."
+)
+
+pytestmark = pytest.mark.unit
+
+
+def _agent(monkeypatch, tmp_path, config_id: str) -> BenchmarkingAgent:
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: object()
+    )
+    return BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=SimpleNamespace(info=SimpleNamespace(baseline_actions=[])),
+        config=config_id,
+    )
+
+
+def test_rolling_summary_is_standard_with_the_adapter_loss_policy():
+    standard = get_model_config(STANDARD)
+    adapter = get_model_config(PROVIDER_ADAPTER)
+    expected = deepcopy(standard)
+    expected["id"] = ROLLING_SUMMARY
+    expected["agent"]["MAX_CONTEXT_LENGTH"] = adapter["agent"]["MAX_CONTEXT_LENGTH"]
+    expected["runtime"]["compaction"] = adapter["runtime"]["compaction"]
+
+    assert get_model_config(ROLLING_SUMMARY) == expected
+    assert expected["runtime"]["state"] == "manual_rolling"
+    assert expected["agent"]["MAX_CONTEXT_LENGTH"] == 1_048_576
+    assert expected["runtime"]["compaction"] == {
+        "strategy": "harness_summary",
+        "trigger_tokens": 175_000,
+        "summary_max_output_tokens": 8_192,
+        "summary_input_headroom_tokens": 8_192,
+    }
+
+
+def test_notes_off_differs_from_rolling_summary_only_in_the_flag():
+    expected = deepcopy(get_model_config(ROLLING_SUMMARY))
+    expected["id"] = NOTES_OFF
+    expected["agent"]["carry_forward_instruction"] = False
+
+    assert get_model_config(NOTES_OFF) == expected
+
+
+@pytest.mark.parametrize("config_id", [ROLLING_SUMMARY, NOTES_OFF])
+def test_request_client_and_pricing_match_both_ends_of_the_path(config_id):
+    config = get_model_config(config_id)
+
+    for end in (STANDARD, PROVIDER_ADAPTER):
+        for section in ("client", "request", "pricing"):
+            assert config[section] == get_model_config(end)[section]
+    assert "service_tier" not in config["request"]
+
+
+@pytest.mark.parametrize(
+    ("config_id", "notes"), [(ROLLING_SUMMARY, True), (NOTES_OFF, False)]
+)
+def test_agents_summarize_visible_text(monkeypatch, tmp_path, config_id, notes):
+    agent = _agent(monkeypatch, tmp_path, config_id)
+
+    assert not hasattr(agent, "_stateful_adapter")
+    assert isinstance(agent._rolling_summary_adapter, ManualRollingSummaryAdapter)
+    assert agent._summary_compactor.policy.trigger_tokens == 175_000
+    assert agent._summary_compactor.policy.summary_max_output_tokens == 8_192
+    assert agent.MAX_CONTEXT_LENGTH == 1_048_576
+    assert agent.analysis_mode is False
+    assert (CARRY_FORWARD in agent._build_system_prompt()) is notes
+    meta = json.loads((Path(agent.run_dir) / "run_meta.json").read_text())
+    assert meta["runtime"]["config_id"] == config_id
+    assert meta["runtime"]["state_strategy"] == "manual_rolling"
+    assert meta["runtime"]["compaction"]["context_limit_tokens"] == 1_048_576
+    assert meta["runtime"]["context_trims"] == 0
+
+
+def test_notes_off_system_prompt_equals_the_provider_adapter(monkeypatch, tmp_path):
+    notes_off = _agent(monkeypatch, tmp_path / "s2", NOTES_OFF)
+    adapter = _agent(monkeypatch, tmp_path / "s4", PROVIDER_ADAPTER)
+
+    assert notes_off._build_system_prompt() == adapter._build_system_prompt()
