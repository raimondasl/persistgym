+def _strip_native(inputs: list[dict]) -> list[dict]:
+    """Drop thought steps and SDK-added annotations from replayed native steps."""
+    return [
+        {
+            **item,
+            "content": [
+                {key: value for key, value in part.items() if key != "annotations"}
+                for part in item["content"]
+            ],
+        }
+        for item in inputs
+        if item["type"] != "thought"
+    ]
+
+
+class _BigGame(_Game):
+    """64x64 frames: one observation renders to roughly 12k characters."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.observation_space = self._frame()
+
+    def _frame(self) -> FrameDataRaw:
+        raw = _raw_frame(1)
+        grid = np.zeros((64, 64), dtype=np.int8)
+        grid[len(self.actions) % 64, :] = 7
+        raw.frame = [grid]
+        return raw
+
+    def step(self, action: GameAction, *, data: dict, reasoning: dict) -> FrameDataRaw:
+        self.actions.append(action)
+        self.observation_space = self._frame()
+        return self.observation_space
+
+
+class _GameOverGame(_Game):
+    """Action ``game_over_after`` loses a life; the forced RESET resumes play."""
+
+    def __init__(self, game_over_after: int) -> None:
+        super().__init__()
+        self.game_over_after = game_over_after
+
+    def step(self, action: GameAction, *, data: dict, reasoning: dict) -> FrameDataRaw:
+        frame = super().step(action, data=data, reasoning=reasoning)
+        if action is GameAction.ACTION1 and len(self.actions) == self.game_over_after:
+            frame.state = GameState.GAME_OVER
+        return frame
+
+
+class _OneTokenPerCharServer(_InteractionsServer):
+    """Reports provider usage as one token per character of request text."""
+
+    def tokens_for(self, body: dict, turn: int) -> int:
+        text = body["system_instruction"] + "".join(
+            part["text"] for item in body["input"] for part in item["content"]
+        )
+        return len(text) + 20
+
+
+class TestRollingSummaryPayloads:
+    @pytest.mark.parametrize(
+        ("config_id", "system"),
+        [(ROLLING_SUMMARY, NOTES_PROMPT), (NOTES_OFF, NO_NOTES_PROMPT)],
+    )
+    def test_requests_match_snapshot_through_compaction(
+        self, monkeypatch, tmp_path, config_id, system
+    ):
+        # Turn 2 reports 180k total tokens, above the 175k compaction trigger.
+        server = _InteractionsServer(total_tokens={2: 180_000})
+
+        bodies, agent = _play(
+            monkeypatch, tmp_path, _config(config_id), actions=4, server=server
+        )
+
+        bridge = _user(_bridge("summary of play 1"))
+        assert bodies == [
+            _body(system, [_user(OBS[1])]),
+            _body(system, [_user(OBS[1]), _text_turn(_note(1)), _user(OBS[2])]),
+            # Harness summary before turn 3: the whole visible-text history,
+            # then the summary request, capped at 8,192 output tokens.
+            _body(
+                SUMMARY_SYSTEM_PROMPT,
+                [
+                    _user(OBS[1]),
+                    _text_turn(_note(1)),
+                    _user(OBS[2]),
+                    _text_turn(_note(2)),
+                    _user(SUMMARY_REQUEST_PROMPT),
+                ],
+                summary=True,
+            ),
+            _body(system, [bridge, _user(OBS[3])]),
+            _body(
+                system,
+                [bridge, _user(OBS[3]), _text_turn(_note(3)), _user(OBS[4])],
+            ),
+        ]
+        meta = json.loads((tmp_path / agent.run_dir / "run_meta.json").read_text())
+        assert meta["runtime"]["compaction_count"] == 1
+        assert meta["runtime"]["context_trims"] == 0
+        step = json.loads((tmp_path / agent.run_dir / "step_003.json").read_text())
+        assert step["continuation"]["bridge"] == bridge["content"][0]["text"]
+
+    @pytest.mark.parametrize("config_id", [ROLLING_SUMMARY, NOTES_OFF])
+    def test_no_thought_items_or_reasoning_text_are_sent(
+        self, monkeypatch, tmp_path, config_id
+    ):
+        server = _InteractionsServer(total_tokens={2: 180_000})
+
+        bodies, _ = _play(
+            monkeypatch, tmp_path, _config(config_id), actions=4, server=server
+        )
+
+        assert server.summaries == 1
+        for body in bodies:
+            assert set(_input_types(body)) <= {"user_input", "model_output"}
+            serialized = json.dumps(body)
+            assert "signature" not in serialized
+            assert "opaque-" not in serialized
+            assert "thinking " not in serialized
+
+    @pytest.mark.parametrize("config_id", [ROLLING_SUMMARY, NOTES_OFF])
+    def test_no_compaction_below_trigger(self, monkeypatch, tmp_path, config_id):
+        server = _InteractionsServer(total_tokens={1: 174_999, 2: 174_999})
+
+        bodies, _ = _play(
+            monkeypatch, tmp_path, _config(config_id), actions=3, server=server
+        )
+
+        assert server.summaries == 0
+        assert _input_types(bodies[2]) == [
+            "user_input",
+            "model_output",
+            "user_input",
+            "model_output",
+            "user_input",
+        ]
+
+    def test_notes_off_equals_provider_adapter_without_thought_steps(
+        self, monkeypatch, tmp_path
+    ):
+        # S2 -> S4 adds only native replay: with thought steps removed, every
+        # request, including the summary request, is identical.
+        notes_off, _ = _play(
+            monkeypatch,
+            tmp_path / "s2",
+            _config(NOTES_OFF),
+            actions=4,
+            server=_InteractionsServer(total_tokens={2: 180_000}),
+        )
+        adapter, _ = _play(
+            monkeypatch,
+            tmp_path / "s4",
+            _config(PROVIDER_ADAPTER),
+            actions=4,
+            server=_InteractionsServer(total_tokens={2: 180_000}),
+        )
+
+        assert len(notes_off) == len(adapter) == 5
+        for s2_body, s4_body in zip(notes_off, adapter, strict=True):
+            assert s2_body == {**s4_body, "input": _strip_native(s4_body["input"])}
+
+    def test_buffered_game_over_is_summarized_like_the_provider_adapter(
+        self, monkeypatch, tmp_path
+    ):
+        # Action 2 loses a life and reports usage above the trigger. The
+        # forced RESET buffers the GAME_OVER frame before the summary runs.
+        # At 4ca00e6 the Google adapter summarizes that unpresented frame
+        # (it does not implement 09a307b's PendingCompactionInputs), and the
+        # rolling summary does the same.
+        def _play_with_game_over(config_id: str, path: str) -> list[dict]:
+            a1, reset = GameAction.ACTION1, GameAction.RESET
+            bodies, _ = _play(
+                monkeypatch,
+                tmp_path / path,
+                _config(config_id),
+                actions=5,
+                server=_InteractionsServer(total_tokens={2: 180_000}),
+                game=_GameOverGame(game_over_after=2),
+                expected_actions=[a1, a1, reset, a1, a1],
+            )
+            return bodies
+
+        notes_off = _play_with_game_over(NOTES_OFF, "s2")
+        adapter = _play_with_game_over(PROVIDER_ADAPTER, "s4")
+
+        summary = notes_off[2]
+        assert summary["system_instruction"] == SUMMARY_SYSTEM_PROMPT
+        assert [item["type"] for item in summary["input"]][-2:] == [
+            "user_input",
+            "user_input",
+        ]
+        game_over = summary["input"][-2]["content"][0]["text"]
+        assert game_over.startswith("State: GAME_OVER")
+        after = notes_off[3]["input"]
+        assert after[0] == _user(_bridge("summary of play 1"))
+        assert all("GAME_OVER" not in item["content"][0]["text"] for item in after)
+        assert len(notes_off) == len(adapter)
+        for s2_body, s4_body in zip(notes_off, adapter, strict=True):
+            assert s2_body == {**s4_body, "input": _strip_native(s4_body["input"])}
+
+    def test_rolling_summary_differs_from_notes_off_only_in_the_instruction(
+        self, monkeypatch, tmp_path
+    ):
+        rolling, _ = _play(
+            monkeypatch,
+            tmp_path / "s1",
+            _config(ROLLING_SUMMARY),
+            actions=4,
+            server=_InteractionsServer(total_tokens={2: 180_000}),
+        )
+        notes_off, _ = _play(
+            monkeypatch,
+            tmp_path / "s2",
+            _config(NOTES_OFF),
+            actions=4,
+            server=_InteractionsServer(total_tokens={2: 180_000}),
+        )
+
+        for s1_body, s2_body in zip(rolling, notes_off, strict=True):
+            if s1_body["system_instruction"] == NOTES_PROMPT:
+                s1_body = {**s1_body, "system_instruction": NO_NOTES_PROMPT}
+            assert s1_body == s2_body
+
+    def test_drop_oldest_never_fires_while_standard_trims(self, monkeypatch, tmp_path):
+        # About 12k characters per observation and one token per character:
+        # Standard starts dropping turns above 175k characters, while the
+        # rolling summary compacts at 175k provider tokens instead.
+        actions = 24
+        standard, _ = _play(
+            monkeypatch,
+            tmp_path / "s0",
+            _config(STANDARD),
+            actions=actions,
+            server=_OneTokenPerCharServer(),
+            game=_BigGame(),
+        )
+        server = _OneTokenPerCharServer()
+        rolling, agent = _play(
+            monkeypatch,
+            tmp_path / "s1",
+            _config(ROLLING_SUMMARY),
+            actions=actions,
+            server=server,
+            game=_BigGame(),
+        )
+
+        first_obs = standard[0]["input"][0]
+        assert any(body["input"][0] != first_obs for body in standard)
+        assert server.summaries >= 1
+        action_bodies = [
+            body for body in rolling if body["system_instruction"] == NOTES_PROMPT
+        ]
+        assert len(action_bodies) == actions
+        bridges = [
+            _user(_bridge(f"summary of play {n}"))
+            for n in range(1, server.summaries + 1)
+        ]
+        for body in action_bodies:
+            assert body["input"][0] == first_obs or body["input"][0] in bridges
+        meta = json.loads((tmp_path / "s1" / agent.run_dir / "run_meta.json").read_text())
+        assert meta["runtime"]["context_trims"] == 0
+        assert meta["runtime"]["compaction_count"] == server.summaries
 
 
