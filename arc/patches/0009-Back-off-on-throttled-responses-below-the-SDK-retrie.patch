+def _agent(monkeypatch, tmp_path, config, provider, clock) -> BenchmarkingAgent:
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("GOOGLE_API_KEY", "test-key")
+    monkeypatch.setattr("benchmarking.agent.get_model_config", lambda _id: config)
+    monkeypatch.setattr(
+        "benchmarking.agent.default_http_transport",
+        lambda: httpx.MockTransport(provider),
+    )
+    agent = BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=_Game(),
+        config=config["id"],
+    )
+    agent._transport_retry._sleep = clock.sleep
+    agent._transport_retry._clock = clock.monotonic
+    agent._transport_retry._rng = lambda: 0.0
+    return agent
+
+
+def _action_body(request: dict) -> dict:
+    if request.get("system_instruction") == SUMMARY_SYSTEM_PROMPT:
+        return _interaction("summary", total=500)
+    turn = sum(
+        1 for item in request["input"] if item["type"] == "user_input"
+    )
+    return _interaction("ACTION1", total=180_000 if turn == 2 else 120)
