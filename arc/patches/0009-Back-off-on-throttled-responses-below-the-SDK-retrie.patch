+class TestThrottleBackoffTransport:
+    def test_retries_429_and_503_then_returns_the_success(self):
+        clock, script = _Clock(), _Script([429, 503])
+        transport = _transport(script, clock)
+
+        response = _send(transport)
+
+        assert response.status_code == 200
+        assert len(script.requests) == 3
+        assert clock.sleeps == [2.0, 4.0]
+        assert transport.stats.throttled_responses == 2
+        assert transport.stats.retries == 2
+        assert transport.stats.wait_seconds == 6.0
+        assert transport.stats.passed_through == 0
+
+    def test_delay_doubles_up_to_the_maximum(self):
+        clock, script = _Clock(), _Script([429] * 6)
+
+        _send(_transport(script, clock, initial_delay_seconds=2, max_delay_seconds=10))
+
+        assert clock.sleeps == [2, 4, 8, 10, 10, 10]
+
+    def test_jitter_only_shortens_the_delay(self):
+        clock, script = _Clock(), _Script([429])
+        transport = ThrottleBackoffTransport(
+            httpx.MockTransport(script),
+            TransportRetryPolicy(jitter_ratio=0.25),
+            sleep=clock.sleep,
+            clock=clock.monotonic,
+            rng=lambda: 1.0,
+        )
