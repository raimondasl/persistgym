@@ -0,0 +1,516 @@
+"""HTTP-level backoff on throttled responses (client.transport_retry)."""
+
+import json
+from copy import deepcopy
+from types import SimpleNamespace
+
+import httpx
+import numpy as np
+import pytest
+import yaml
+from arcengine import FrameDataRaw, GameAction, GameState
+
+import benchmarking.model_config as model_config
+from benchmarking import runtime_clients
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.base import ExitReason
+from benchmarking.compaction import SUMMARY_SYSTEM_PROMPT
+from benchmarking.model_config import get_model_config
+from benchmarking.runtime_transport import (
+    ThrottleBackoffTransport,
+    TransportRetryPolicy,
+    default_http_transport,
+)
+
+pytestmark = [
+    pytest.mark.unit,
+    pytest.mark.filterwarnings("ignore:Interactions usage is experimental"),
+]
+
+STANDARD = "google-gemini-3-8-flash-high"
+PROVIDER_ADAPTER = "google-gemini-3-8-flash-high-provider-adapter"
+NO_SDK_RETRY = {"x-should-retry": "false"}
