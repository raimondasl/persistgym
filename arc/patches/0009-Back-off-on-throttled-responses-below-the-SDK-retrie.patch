+class _Clock:
+    def __init__(self) -> None:
+        self.now = 0.0
+        self.sleeps: list[float] = []
+
+    def monotonic(self) -> float:
+        return self.now
+
+    def wall(self) -> float:
+        return 1_000_000.0 + self.now
+
+    def sleep(self, seconds: float) -> None:
+        self.sleeps.append(seconds)
+        self.now += seconds
+
+
+class _Script:
+    """Answers with the scripted statuses, then with ``final`` forever."""
+
+    def __init__(self, statuses: list[int], final: int = 200, headers=None) -> None:
+        self.statuses = list(statuses)
+        self.final = final
+        self.headers = headers or {}
+        self.requests: list[httpx.Request] = []
+
+    def __call__(self, request: httpx.Request) -> httpx.Response:
+        self.requests.append(request)
+        status = self.statuses.pop(0) if self.statuses else self.final
+        return httpx.Response(status, headers=self.headers, json={"status": status})
+
+
+def _transport(script, clock, **policy) -> ThrottleBackoffTransport:
+    return ThrottleBackoffTransport(
+        httpx.MockTransport(script),
+        TransportRetryPolicy(**{"jitter_ratio": 0.0, **policy}),
+        sleep=clock.sleep,
+        clock=clock.monotonic,
+        wall_clock=clock.wall,
+    )
+
+
+def _send(transport, body: bytes = b'{"q": 1}') -> httpx.Response:
+    with httpx.Client(transport=transport) as client:
+        return client.post("https://provider.test/v1/call", content=body)
+
