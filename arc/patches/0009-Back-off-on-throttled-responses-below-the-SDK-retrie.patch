+    def test_episode_budget_bounds_waiting_and_success_resets_it(self):
+        clock, script = _Clock(), _Script([429] * 4 + [200, 429])
+        transport = _transport(script, clock, max_wait_seconds=5)
+
+        first = _send(transport)
+        # A follow-up call in the same throttled episode passes straight through.
+        second = _send(transport)
+        third = _send(transport)
+        fourth = _send(transport)
+
+        assert first.status_code == 429
+        assert clock.sleeps == [2.0, 3.0, 2.0]
+        assert second.status_code == 429
+        assert third.status_code == 200
+        assert fourth.status_code == 200
+        assert transport.stats.passed_through == 2
+        assert transport.stats.longest_episode_seconds == 5.0
+
+    def test_wall_clock_deadline_passes_through_and_is_counted(self):
