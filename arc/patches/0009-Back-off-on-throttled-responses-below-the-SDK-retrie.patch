diff --git a/benchmarking/runtime_transport.py b/benchmarking/runtime_transport.py
new file mode 100644
index 0000000..4a2aed4
--- /dev/null
+++ b/benchmarking/runtime_transport.py
@@ -0,0 +1,185 @@
+"""HTTP-level backoff for throttled model requests.
+
+Gemini Flex answers 503 when it is at capacity and 429 for rate limits or
+resource exhaustion, and expects the client to back off. The SDKs retry such
+responses only a few times within seconds, and the harness then spends its
+model retries (``MAX_RETRIES``) without waiting, so a short congestion window
+ends a run. ``ThrottleBackoffTransport`` wraps the SDK's HTTP transport and
+retries throttled responses with exponential backoff before the SDK sees them,
+so neither the SDK's retries nor ``MAX_RETRIES`` are spent on throttling.
+
+Waiting is bounded per throttled episode (consecutive throttled responses
+with no other response in between) and by an optional wall-clock deadline.
+Once either bound is reached, throttled responses pass through unchanged and
+the usual SDK and harness retry handling applies.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import random
+import ssl
+import threading
+import time
+from collections.abc import Callable
+from email.utils import parsedate_to_datetime
+from typing import Any
+
+import certifi
+import httpx
+from pydantic import BaseModel, ConfigDict, Field
+
+logger = logging.getLogger()
+
+
+class TransportRetryPolicy(BaseModel):
+    """``client.transport_retry`` settings."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    status_codes: list[int] = Field(default_factory=lambda: [429, 503], min_length=1)
+    initial_delay_seconds: float = Field(default=2.0, gt=0)
+    max_delay_seconds: float = Field(default=60.0, gt=0)
+    # Longest total wait across one throttled episode.
+    max_wait_seconds: float = Field(default=1_800.0, gt=0)
+    jitter_ratio: float = Field(default=0.25, ge=0, le=1)
+
+
+class TransportRetryStats(BaseModel):
+    throttled_responses: int = 0
+    retries: int = 0
+    wait_seconds: float = 0.0
+    longest_episode_seconds: float = 0.0
+    # Throttled responses returned to the SDK because a bound was reached.
+    passed_through: int = 0
+    deadline_passthroughs: int = 0
+
+
+def default_http_transport() -> httpx.HTTPTransport:
+    """Plain HTTPS transport with the CA bundle the SDK clients use by default.
+
+    Mirrors google-genai's default SSL context (``SSL_CERT_FILE`` or certifi,
+    plus ``SSL_CERT_DIR``), which also matches httpx's own default.
+    """
+    context = ssl.create_default_context(
+        cafile=os.environ.get("SSL_CERT_FILE", certifi.where()),
+        capath=os.environ.get("SSL_CERT_DIR"),
+    )
+    return httpx.HTTPTransport(verify=context)
+
+
+def _retry_after_seconds(response: httpx.Response) -> float | None:
+    value: str | None = response.headers.get("retry-after")
+    if value is None:
+        return None
+    try:
+        return max(0.0, float(value))
+    except ValueError:
+        pass
+    try:
+        seconds: float = parsedate_to_datetime(value).timestamp() - time.time()
+    except (TypeError, ValueError):
+        return None
+    return max(0.0, seconds)
+
+
+class ThrottleBackoffTransport(httpx.BaseTransport):
+    def __init__(
+        self,
+        inner: httpx.BaseTransport,
+        policy: TransportRetryPolicy,
+        *,
+        deadline: Callable[[], float | None] | None = None,
+        sleep: Callable[[float], None] = time.sleep,
+        clock: Callable[[], float] = time.monotonic,
+        wall_clock: Callable[[], float] = time.time,
+        rng: Callable[[], float] = random.random,
+    ) -> None:
+        self.inner = inner
+        self.policy = policy
+        self.stats = TransportRetryStats()
+        self._deadline = deadline
+        self._sleep = sleep
+        self._clock = clock
+        self._wall_clock = wall_clock
+        self._rng = rng
+        self._lock = threading.Lock()
+        self._episode_start: float | None = None
+        self._episode_retries = 0
+
+    def _backoff_seconds(self, response: httpx.Response) -> float:
+        policy = self.policy
+        delay: float = min(
+            policy.initial_delay_seconds * (2.0**self._episode_retries),
+            policy.max_delay_seconds,
+        )
+        delay *= 1.0 - policy.jitter_ratio * self._rng()
+        retry_after = _retry_after_seconds(response)
+        if retry_after is not None:
+            delay = max(delay, retry_after)
+        return delay
+
+    def _end_episode(self) -> None:
+        with self._lock:
+            if self._episode_start is not None:
+                elapsed = self._clock() - self._episode_start
+                self.stats.longest_episode_seconds = max(
+                    self.stats.longest_episode_seconds, round(elapsed, 3)
+                )
+            self._episode_start = None
+            self._episode_retries = 0
+
+    def _pass_through(
+        self, request: httpx.Request, response: httpx.Response, reason: str
+    ) -> httpx.Response:
+        with self._lock:
+            self.stats.passed_through += 1
+            if reason == "deadline":
+                self.stats.deadline_passthroughs += 1
+        logger.warning(
+            "HTTP %s from %s passed to the SDK without further backoff (%s).",
+            response.status_code,
+            request.url.host,
+            reason,
+        )
+        return response
+
+    def handle_request(self, request: httpx.Request) -> httpx.Response:
+        while True:
+            response = self.inner.handle_request(request)
+            if response.status_code not in self.policy.status_codes:
+                self._end_episode()
+                return response
+
+            with self._lock:
+                self.stats.throttled_responses += 1
+                now = self._clock()
+                if self._episode_start is None:
+                    self._episode_start = now
+                budget = self.policy.max_wait_seconds - (now - self._episode_start)
+            if budget <= 0:
+                return self._pass_through(request, response, "max_wait_seconds")
+            delay = min(self._backoff_seconds(response), budget)
+            deadline = self._deadline() if self._deadline is not None else None
+            if deadline is not None and self._wall_clock() + delay >= deadline:
+                return self._pass_through(request, response, "deadline")
+
+            response.close()
+            logger.info(
+                "HTTP %s; retrying in %.1f s without using a model retry.",
+                response.status_code,
+                delay,
+            )
+            self._sleep(delay)
+            with self._lock:
+                self.stats.retries += 1
+                self.stats.wait_seconds = round(self.stats.wait_seconds + delay, 3)
+                self._episode_retries += 1
+
+    def close(self) -> None:
+        self.inner.close()
+
+    def summary(self) -> dict[str, Any]:
+        """Policy and counters for run metadata."""
+        return {"policy": self.policy.model_dump(), **self.stats.model_dump()}
