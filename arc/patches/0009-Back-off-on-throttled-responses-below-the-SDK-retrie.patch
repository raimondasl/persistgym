+class _ThrottlingProvider:
+    """Answers each logical call after its scripted throttle statuses.
+
+    ``throttled`` maps a 1-based call number to the statuses returned before
+    that call is answered. Throttle responses tell the SDK not to retry, so
+    only the transport under test can retry them.
+    """
+
+    def __init__(self, body, throttled: dict[int, list[int]] | None = None) -> None:
+        self.body = body
+        self.throttled = throttled or {}
+        self.calls = 0
+        self.bodies: list[dict] = []
+        self.hosts: list[str] = []
+        self._queue: list[int] | None = None
+
+    def __call__(self, request: httpx.Request) -> httpx.Response:
+        self.hosts.append(request.url.host)
+        if self._queue is None:
+            self.calls += 1
+            self.bodies.append(json.loads(request.content))
+            self._queue = list(self.throttled.get(self.calls, []))
+        if self._queue:
+            status = self._queue.pop(0)
+            return httpx.Response(status, headers=NO_SDK_RETRY, json={"error": status})
+        self._queue = None
+        body = self.body(self.bodies[-1]) if callable(self.body) else self.body
+        return httpx.Response(200, request=request, json=body)
+
