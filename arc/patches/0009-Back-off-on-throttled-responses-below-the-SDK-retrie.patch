+def _interaction(text: str = "ACTION1", total: int = 120) -> dict:
+    return {
+        "id": "interaction-1",
+        "created": "2026-10-01T00:00:00Z",
+        "updated": "2026-10-01T00:00:00Z",
+        "status": "completed",
+        "steps": [
+            {"type": "thought", "signature": "sig", "summary": [{"type": "text", "text": "t"}]},
+            {"type": "model_output", "content": [{"type": "text", "text": text}]},
+        ],
+        "usage": {
