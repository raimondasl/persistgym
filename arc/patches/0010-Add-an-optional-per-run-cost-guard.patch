+    def _estimated_cost_usd(self) -> float:
+        """Run spend so far at the configured per-million prices.
+
+        Covers every recorded model request: accepted and retried action
+        attempts and harness summaries. Like ARC's published costs, it applies
+        no cache or service-tier discount.
+        """
+        usage = self.run_record.total_usage
+        pricing = getattr(self, "_pricing", {}) or {}
+        return calculate_cost(usage.prompt_tokens, pricing.get("input", 0.0)) + (
+            calculate_cost(usage.completion_tokens, pricing.get("output", 0.0))
+        )
+
+    def _cost_cap_reached(self) -> bool:
+        cap = getattr(self, "MAX_RUN_COST_USD", None)
+        if cap is None or not hasattr(self, "run_record"):
+            return False
+        estimated = self._estimated_cost_usd()
+        if estimated <= cap:
+            return False
+        logger.info(
+            f"{self.game_id} - Estimated spend ${estimated:.4f} exceeds "
+            f"MAX_RUN_COST_USD ${cap:.4f}. Stopping."
+        )
+        return True
