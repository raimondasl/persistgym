+++ b/tests/unit/test_cost_guard.py
@@ -0,0 +1,238 @@
+"""Optional per-run cost guard (agent.MAX_RUN_COST_USD, exit COST_CAP)."""
+
+import json
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import yaml
+from arcengine import FrameDataRaw, GameAction, GameState
+
+import benchmarking.model_config as model_config
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.base import ExitReason
+from benchmarking.compaction import SUMMARY_SYSTEM_PROMPT
+from benchmarking.model_config import get_model_config
+from benchmarking.runtime_models import ModelRequest, ModelResponse, NormalizedUsage
+
+pytestmark = pytest.mark.unit
+
+PATH_PROFILES = [
+    "google-gemini-3-8-flash-high",
+    "google-gemini-3-8-flash-high-rolling-summary",
+    "google-gemini-3-8-flash-high-rolling-summary-notes-off",
+    "google-gemini-3-8-flash-high-provider-adapter",
+]
+
+
+def _config(**agent: object) -> dict:
+    return {
+        "id": "cost-guard-test",
+        "agent": {"MAX_CONTEXT_LENGTH": 100_000_000, **agent},
+        "runtime": {
+            "sdk": "openai-python",
+            "api": "chat_completions",
+            "state": "manual_rolling",
+        },
+        "client": {"api_key_env": "OPENAI_API_KEY"},
+        "request": {"model": "test-model", "max_completion_tokens": 512},
+        # $1 per million input tokens, $2 per million output tokens.
+        "pricing": {"input": 1.0, "output": 2.0},
+    }
+
+
+class _Adapter:
+    """Each action call costs $1.00 at the test prices; summaries $0.50."""
+
+    def __init__(
+        self, trigger_on: int | None = None, unparseable_on: int | None = None
+    ) -> None:
+        self.calls = 0
+        self.summaries = 0
+        self.trigger_on = trigger_on
+        self.unparseable_on = unparseable_on
+
+    def invoke(self, request: ModelRequest) -> ModelResponse:
+        if request.messages[0].content == SUMMARY_SYSTEM_PROMPT:
+            self.summaries += 1
+            return ModelResponse(
+                output_text="summary",
+                usage=NormalizedUsage(
+                    input_tokens=500_000, output_tokens=0, total_tokens=500_000
+                ),
+            )
+        self.calls += 1
+        # $0.50 input + $0.50 output; the reported total only drives compaction.
+        total = 2_000_000 if self.calls == self.trigger_on else 750_000
+        return ModelResponse(
+            output_text="no action" if self.calls == self.unparseable_on else "ACTION1",
+            usage=NormalizedUsage(
+                input_tokens=500_000, output_tokens=250_000, total_tokens=total
+            ),
+        )
+
+
+def _raw_frame(value: int, state: GameState = GameState.NOT_FINISHED) -> FrameDataRaw:
+    raw = FrameDataRaw()
+    raw.game_id = "game-id"
+    raw.frame = [np.array([[value, 0], [0, value]], dtype=np.int8)]
+    raw.state = state
+    raw.levels_completed = 0
+    raw.win_levels = 1
+    raw.action_input = None
+    raw.guid = "guid-1"
+    raw.full_reset = False
+    raw.available_actions = [GameAction.ACTION1.value]
+    return raw
+
+
+class _Game:
+    def __init__(self, win_after: int | None = None) -> None:
+        self.info = SimpleNamespace(baseline_actions=[])
+        self.observation_space = _raw_frame(1)
+        self.actions: list[GameAction] = []
+        self.win_after = win_after
+
+    def step(self, action: GameAction, *, data: dict, reasoning: dict) -> FrameDataRaw:
+        self.actions.append(action)
+        won = len(self.actions) == self.win_after
+        self.observation_space = _raw_frame(
+            len(self.actions) + 1, GameState.WIN if won else GameState.NOT_FINISHED
+        )
+        return self.observation_space
+
+
+def _run(monkeypatch, tmp_path, config, *, budget=10, adapter=None, game=None):
+    adapter = adapter or _Adapter()
+    game = game or _Game()
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("benchmarking.agent.get_model_config", lambda _id: config)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: object()
+    )
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_adapter", lambda **_kwargs: adapter
+    )
+    agent = BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=game,
+        config=config["id"],
+    )
+    agent._level_action_budgets = [budget]
+    agent.MAX_ACTIONS = budget
+    agent.main()
+    meta = json.loads((Path(agent.run_dir) / "run_meta.json").read_text())
+    return agent, game, meta
+
+
+def _write(tmp_path, monkeypatch, config) -> None:
+    path = tmp_path / "model_configs.yaml"
+    path.write_text(yaml.safe_dump([config]))
+    monkeypatch.setattr(model_config, "MODEL_CONFIG_PATH", path)
+
+
+class TestCostGuard:
+    def test_is_off_in_the_path_profiles_and_by_default(self, monkeypatch, tmp_path):
+        for config_id in PATH_PROFILES:
+            assert "MAX_RUN_COST_USD" not in get_model_config(config_id)["agent"]
+
+        agent, game, meta = _run(monkeypatch, tmp_path, _config(), budget=4)
+
+        assert agent.MAX_RUN_COST_USD is None
+        assert len(game.actions) == 4
+        assert meta["exit_reason"] == ExitReason.ACTION_BUDGET.value
+        assert "cost_guard" not in meta
+
+    def test_run_ends_with_cost_cap_once_spend_exceeds_the_cap(
+        self, monkeypatch, tmp_path
+    ):
+        agent, game, meta = _run(
+            monkeypatch, tmp_path, _config(MAX_RUN_COST_USD=2.5)
+        )
+
+        # Each step costs $1.00; the action whose call crossed $2.50 still runs.
+        assert len(game.actions) == 3
+        assert meta["exit_reason"] == ExitReason.COST_CAP.value
+        assert meta["cost_guard"] == {"max_usd": 2.5, "estimated_cost_usd": 3.0}
+
+    def test_spend_equal_to_the_cap_does_not_stop(self, monkeypatch, tmp_path):
+        _, game, meta = _run(monkeypatch, tmp_path, _config(MAX_RUN_COST_USD=3))
+
+        assert len(game.actions) == 4
+        assert meta["exit_reason"] == ExitReason.COST_CAP.value
+        assert meta["cost_guard"]["estimated_cost_usd"] == 4.0
+
+    def test_retried_attempts_count(self, monkeypatch, tmp_path):
+        adapter = _Adapter(unparseable_on=1)
+
+        _, game, meta = _run(
+            monkeypatch, tmp_path, _config(MAX_RUN_COST_USD=1.5), adapter=adapter
+        )
+
+        assert len(game.actions) == 1
+        assert meta["exit_reason"] == ExitReason.COST_CAP.value
+        assert meta["cost_guard"]["estimated_cost_usd"] == 2.0
+
+    def test_harness_summaries_count(self, monkeypatch, tmp_path):
+        config = _config(MAX_RUN_COST_USD=2.4)
+        config["runtime"]["compaction"] = {
+            "strategy": "harness_summary",
+            "trigger_tokens": 1_500_000,
+        }
+        adapter = _Adapter(trigger_on=1)
+
+        _, game, meta = _run(monkeypatch, tmp_path, config, adapter=adapter)
+
+        # $1.00 + summary $0.50 + $1.00 = $2.50 after two actions.
+        assert adapter.summaries == 1
+        assert len(game.actions) == 2
+        assert meta["exit_reason"] == ExitReason.COST_CAP.value
+        assert meta["cost_guard"]["estimated_cost_usd"] == 2.5
+
+    def test_win_takes_precedence(self, monkeypatch, tmp_path):
+        _, _, meta = _run(
+            monkeypatch,
+            tmp_path,
+            _config(MAX_RUN_COST_USD=1.5),
+            game=_Game(win_after=2),
+        )
+
+        assert meta["exit_reason"] == ExitReason.GAME_WIN.value
+
+    def test_action_budget_takes_precedence(self, monkeypatch, tmp_path):
+        _, game, meta = _run(
+            monkeypatch, tmp_path, _config(MAX_RUN_COST_USD=1.5), budget=2
+        )
+
+        assert len(game.actions) == 2
+        assert meta["exit_reason"] == ExitReason.ACTION_BUDGET.value
+
+
+class TestCostGuardValidation:
+    @pytest.mark.parametrize("value", [0, -1, True, "5"])
+    def test_rejects_non_positive_or_non_numeric_caps(self, tmp_path, monkeypatch, value):
+        _write(tmp_path, monkeypatch, _config(MAX_RUN_COST_USD=value))
+
+        with pytest.raises(ValueError, match="MAX_RUN_COST_USD must be a positive"):
+            model_config.load_model_configs()
+
+    def test_requires_pricing(self, tmp_path, monkeypatch):
+        config = _config(MAX_RUN_COST_USD=5)
+        del config["pricing"]
+        _write(tmp_path, monkeypatch, config)
+
+        with pytest.raises(ValueError, match="numeric pricing.input and pricing.output"):
+            model_config.load_model_configs()
+
+    def test_accepts_a_positive_cap(self, tmp_path, monkeypatch):
+        config = deepcopy(get_model_config(PATH_PROFILES[0]))
+        config["agent"]["MAX_RUN_COST_USD"] = 25.0
+        _write(tmp_path, monkeypatch, config)
+
+        assert model_config.load_model_configs()[0]["agent"]["MAX_RUN_COST_USD"] == 25.0
