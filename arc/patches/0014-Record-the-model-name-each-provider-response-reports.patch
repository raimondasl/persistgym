index 0000000..9668de0
--- /dev/null
+++ b/tests/unit/test_reported_model.py
@@ -0,0 +1,274 @@
+"""The model name each provider response reports is recorded per step and per run."""
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import httpx
+import numpy as np
+import pytest
+from arcengine import FrameDataRaw, GameAction, GameState
+from google import genai as google_genai
+from openai import OpenAI
+
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.model_config import get_model_config
+from benchmarking.runtime_adapters import (
+    GoogleGenAIInteractionsAdapter,
+    OpenAIChatCompletionsAdapter,
+    OpenAIResponsesAdapter,
+)
+from benchmarking.runtime_models import Message, ModelRequest
+
+pytestmark = [
+    pytest.mark.unit,
+    pytest.mark.filterwarnings("ignore:Interactions usage is experimental"),
+]
+
+ROLLING_SUMMARY = "google-gemini-3-8-flash-high-rolling-summary"
+PROVIDER_ADAPTER = "google-gemini-3-8-flash-high-provider-adapter"
+SUMMARY_SYSTEM_PROMPT = (
+    "You create concise conversation summaries for reliable continuation. "
+    "Return only the requested summary."
+)
+ACTION_MODEL = "gemini-3.8-flash-test-001"
+SUMMARY_MODEL = "gemini-3.8-flash-test-002"
+
+
+def _interaction_json(index: int, text: str, total: int, model: str | None) -> dict:
+    payload = {
+        "id": f"interaction-{index}",
+        "created": "2026-10-01T00:00:00Z",
+        "updated": "2026-10-01T00:00:00Z",
+        "status": "completed",
+        "steps": [
+            {
+                "type": "thought",
+                "signature": f"opaque-{index}",
+                "summary": [{"type": "text", "text": f"thinking {index}"}],
+            },
+            {"type": "model_output", "content": [{"type": "text", "text": text}]},
+        ],
+        "usage": {
+            "total_input_tokens": total - 20,
+            "total_output_tokens": 10,
+            "total_thought_tokens": 10,
+            "total_tokens": total,
+        },
+    }
+    if model is not None:
+        payload["model"] = model
+    return payload
+
+
+class _Server:
+    """Interactions stub: action replies report one model, summaries another."""
+
+    def __init__(self, *, report: bool, trigger_turn: int = 2) -> None:
+        self.report = report
+        self.trigger_turn = trigger_turn
+        self.turns = 0
+        self.requests = 0
+
+    def __call__(self, request: httpx.Request) -> httpx.Response:
+        body = json.loads(request.content)
+        self.requests += 1
+        if body.get("system_instruction") == SUMMARY_SYSTEM_PROMPT:
+            text, total, model = "summary", 1_000, SUMMARY_MODEL
+        else:
+            self.turns += 1
+            text = f"turn {self.turns}: ACTION1"
+            total = 180_000 if self.turns == self.trigger_turn else 120
+            model = ACTION_MODEL
+        payload = _interaction_json(
+            self.requests, text, total, model if self.report else None
+        )
+        return httpx.Response(200, request=request, json=payload)
+
+
+def _raw_frame(value: int) -> FrameDataRaw:
+    raw = FrameDataRaw()
+    raw.game_id = "game-id"
+    raw.frame = [np.array([[value, 0], [0, value]], dtype=np.int8)]
+    raw.state = GameState.NOT_FINISHED
+    raw.levels_completed = 0
+    raw.win_levels = 1
+    raw.action_input = None
+    raw.guid = "guid-1"
+    raw.full_reset = False
+    raw.available_actions = [GameAction.ACTION1.value]
+    return raw
+
+
+class _Game:
+    def __init__(self) -> None:
+        self.info = SimpleNamespace(baseline_actions=[])
+        self.observation_space = _raw_frame(1)
+        self.actions = 0
+
+    def step(self, action: GameAction, *, data: dict, reasoning: dict) -> FrameDataRaw:
+        self.actions += 1
+        self.observation_space = _raw_frame(self.actions + 1)
+        return self.observation_space
+
+
+def _play(monkeypatch, tmp_path: Path, config_id: str, server: _Server) -> Path:
+    client = google_genai.Client(
+        api_key="test-key",
+        http_options={
+            "base_url": "https://example.test",
+            "httpx_client": httpx.Client(transport=httpx.MockTransport(server)),
+        },
+    )
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: client
+    )
+    agent = BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=_Game(),
+        config=config_id,
+    )
+    agent._level_action_budgets = [3]
+    try:
+        agent.main()
+    finally:
+        client.close()
+    return tmp_path / agent.run_dir
+
+
+def _read(run_dir: Path, name: str) -> dict:
+    return json.loads((run_dir / name).read_text())
+
+
+class TestNormalizedResponses:
+    def test_google_interactions_reports_the_model(self):
+        server = _Server(report=True)
+        client = google_genai.Client(
+            api_key="test-key",
+            http_options={
+                "base_url": "https://example.test",
+                "httpx_client": httpx.Client(transport=httpx.MockTransport(server)),
+            },
+        )
+        request = ModelRequest(
+            messages=[Message(role="user", content="frame")],
+            request_config={"model": "gemini-3.8-flash"},
+        )
+
+        response = GoogleGenAIInteractionsAdapter(client).invoke(request)
+
+        assert response.reported_model == ACTION_MODEL
+
+    def test_google_interactions_without_a_model_field(self):
+        server = _Server(report=False)
+        client = google_genai.Client(
+            api_key="test-key",
+            http_options={
+                "base_url": "https://example.test",
+                "httpx_client": httpx.Client(transport=httpx.MockTransport(server)),
+            },
+        )
+        request = ModelRequest(
+            messages=[Message(role="user", content="frame")],
+            request_config={"model": "gemini-3.8-flash"},
+        )
+
+        assert GoogleGenAIInteractionsAdapter(client).invoke(request).reported_model is None
+
+    def test_openai_responses_and_chat_report_the_model(self):
+        def respond(request: httpx.Request) -> httpx.Response:
+            if request.url.path.endswith("/responses"):
+                payload = {
+                    "id": "resp_1",
+                    "object": "response",
+                    "created_at": 0,
+                    "status": "completed",
+                    "model": "gpt-test-2026-01-01",
+                    "output": [
+                        {
+                            "type": "message",
+                            "id": "msg_1",
+                            "role": "assistant",
+                            "status": "completed",
+                            "content": [
+                                {"type": "output_text", "text": "ACTION1", "annotations": []}
+                            ],
+                        }
+                    ],
+                    "usage": {
+                        "input_tokens": 10,
+                        "output_tokens": 2,
+                        "total_tokens": 12,
+                        "input_tokens_details": {"cached_tokens": 0},
+                        "output_tokens_details": {"reasoning_tokens": 0},
+                    },
+                    "parallel_tool_calls": True,
+                    "tool_choice": "auto",
+                    "tools": [],
+                }
+            else:
+                payload = {
+                    "id": "chatcmpl-1",
+                    "object": "chat.completion",
+                    "created": 0,
+                    "model": "gpt-test-2026-01-02",
+                    "choices": [
+                        {
+                            "index": 0,
+                            "finish_reason": "stop",
+                            "message": {"role": "assistant", "content": "ACTION1"},
+                        }
+                    ],
+                    "usage": {"prompt_tokens": 10, "completion_tokens": 2, "total_tokens": 12},
+                }
+            return httpx.Response(200, request=request, json=payload)
+
+        client = OpenAI(
+            api_key="test-key",
+            base_url="https://example.test/v1",
+            http_client=httpx.Client(transport=httpx.MockTransport(respond)),
+        )
+        request = ModelRequest(
+            messages=[Message(role="user", content="frame")],
+            request_config={"model": "gpt-test"},
+        )
+
+        responses = OpenAIResponsesAdapter(client).invoke(request)
+        chat = OpenAIChatCompletionsAdapter(client).invoke(request)
+
+        assert responses.reported_model == "gpt-test-2026-01-01"
+        assert chat.reported_model == "gpt-test-2026-01-02"
+
+
+class TestRunFiles:
+    @pytest.mark.parametrize("config_id", [ROLLING_SUMMARY, PROVIDER_ADAPTER])
+    def test_steps_compactions_and_run_meta_record_reported_models(
+        self, monkeypatch, tmp_path, config_id
+    ):
+        get_model_config(config_id)  # the profile exists
+        run_dir = _play(monkeypatch, tmp_path, config_id, _Server(report=True))
+
+        steps = [_read(run_dir, f"step_{n:03d}.json") for n in (1, 2, 3)]
+        assert [step["reported_model"] for step in steps] == [ACTION_MODEL] * 3
+        assert [step["model"] for step in steps] == ["gemini-3.8-flash"] * 3
+        assert _read(run_dir, "compaction_001.json")["reported_model"] == SUMMARY_MODEL
+        assert _read(run_dir, "run_meta.json")["reported_models"] == [
+            ACTION_MODEL,
+            SUMMARY_MODEL,
+        ]
+
+    @pytest.mark.parametrize("config_id", [ROLLING_SUMMARY, PROVIDER_ADAPTER])
+    def test_fields_are_omitted_when_no_model_is_reported(
+        self, monkeypatch, tmp_path, config_id
+    ):
+        run_dir = _play(monkeypatch, tmp_path, config_id, _Server(report=False))
+
+        assert "reported_model" not in _read(run_dir, "step_001.json")
+        assert "reported_model" not in _read(run_dir, "compaction_001.json")
+        assert "reported_models" not in _read(run_dir, "run_meta.json")
