+# ── No oldest-turn trimming with summary compaction ────────────────────
+
+
+class _FewTokensPerCharServer(_OneTokenPerCharServer):
+    """Reports about one provider token per ten characters of request text."""
+
+    def tokens_for(self, body: dict, turn: int) -> int:
+        return super().tokens_for(body, turn) // 10 + 20
+
+
+class _HugeGame(_BigGame):
+    """Seven 64x64 animation frames: one observation is about 87.5k characters."""
+
+    def _frame(self) -> FrameDataRaw:
+        raw = super()._frame()
+        raw.frame = raw.frame * 7
+        return raw
+
+
+def _chars(body: dict) -> int:
+    """Characters of request text, as the harness estimates context size."""
+    return len(body["system_instruction"]) + sum(
+        len(part["text"]) for item in body["input"] for part in item["content"]
+    )
+
+
+def _full_history(system: str, turns: int) -> list[dict]:
+    """Action requests 1..turns of an untrimmed, uncompacted run."""
+    bodies = []
+    for turn in range(1, turns + 1):
+        inputs = []
+        for earlier in range(1, turn):
+            inputs += [_user(OBS[earlier]), _text_turn(_note(earlier))]
+        bodies.append(_body(system, [*inputs, _user(OBS[turn])]))
+    return bodies
+
