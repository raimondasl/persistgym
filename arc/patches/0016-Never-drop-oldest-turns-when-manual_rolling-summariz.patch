+# ── Oldest-turn trimming ───────────────────────────────────────────────
+
+# Room for the system prompt and the newest two observations only: the third
+# request's history is over this many characters, the second's is not.
+TWO_TURN_LIMIT = len(SYSTEM) + len(_obs(2)) + len("note 2: ACTION1") + len(_obs(3))
+# Ways the character estimate can pass MAX_CONTEXT_LENGTH long before provider
+# usage reaches the summary trigger.
+TRIM_CASES = ["usage-unreported", "few-tokens-per-char", "tiny-chars-per-token-estimate"]
+
+
+class _NoUsageAdapter(_ScriptedAdapter):
+    """Reports no usage on any call."""
+
+    def invoke(self, request: ModelRequest) -> ModelResponse:
+        response = super().invoke(request)
+        return response.model_copy(update={"usage": NormalizedUsage()})
+
+
+def _trim_case_adapter(case: str) -> _ScriptedAdapter:
+    if case == "usage-unreported":
+        return _NoUsageAdapter()
+    if case == "few-tokens-per-char":
+        # About 0.03 provider tokens per character of the third request.
+        return _ScriptedAdapter(total_tokens={turn: 10 for turn in range(1, 5)})
+    return _ScriptedAdapter()
+
+
+def _trim_case_agent(
+    monkeypatch, tmp_path, config, adapter, case, *, actions: int = 3
+) -> BenchmarkingAgent:
+    agent = _agent(monkeypatch, tmp_path, config, adapter, _Game())
+    agent._level_action_budgets = [actions]
+    if case == "tiny-chars-per-token-estimate":
+        # 1,000 estimated tokens per character; the limit stays at 100,000.
+        agent.ESTIMATED_CHARS_PER_TOKEN = 0.001
+    else:
+        agent.MAX_CONTEXT_LENGTH = TWO_TURN_LIMIT
+    return agent
+
+
+def _spy_on_trims(agent: BenchmarkingAgent) -> list[int]:
+    """Record the transcript length at every _trim_to_fit_context call."""
+    calls: list[int] = []
+    trim = agent._trim_to_fit_context
+
+    def _spy() -> None:
+        calls.append(len(agent.conversation))
+        trim()
+
+    agent._trim_to_fit_context = _spy  # type: ignore[method-assign]
+    return calls
+
+
