diff --git a/tests/unit/test_gemini_path_service_tier.py b/tests/unit/test_gemini_path_service_tier.py
new file mode 100644
index 0000000..595423d
--- /dev/null
+++ b/tests/unit/test_gemini_path_service_tier.py
@@ -0,0 +1,161 @@
+"""The Gemini 3.8 Flash high path profiles request the standard tier explicitly.
+
+The four profiles (Standard, rolling summary, rolling summary notes-off,
+Provider Adapter) set ``request.service_tier: "standard"``, the literal the
+pinned google-genai SDK accepts for standard processing on the Interactions
+API. A Flex or priority tier cannot be sent by these profiles, and the tier the
+provider reports is recorded per step.
+"""
+
+import json
+import logging
+import typing
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from arcengine import FrameData, GameAction, GameState
+from google.genai._interactions.types.interaction import Interaction
+from google.genai._interactions.types.interaction_create_params import (
+    BaseCreateModelInteractionParams,
+)
+
+from benchmarking.agent import BenchmarkingAgent
+from benchmarking.model_config import (
+    SERVICE_TIERS_BY_RUNTIME_PAIR,
+    get_model_config,
+    load_model_configs,
+)
+from benchmarking.runtime_models import ModelResponse, NormalizedUsage
+
+pytestmark = pytest.mark.unit
+
+PATH_PROFILES = (
+    "google-gemini-3-8-flash-high",
+    "google-gemini-3-8-flash-high-rolling-summary",
+    "google-gemini-3-8-flash-high-rolling-summary-notes-off",
+    "google-gemini-3-8-flash-high-provider-adapter",
+)
+STANDARD_TIER = "standard"
+
+
+def _literal_values(annotation: object) -> set[str]:
+    """String values of a ``Literal[...]``, also inside ``Optional``."""
+    values: set[str] = set()
+    for arg in typing.get_args(annotation):
+        if isinstance(arg, str):
+            values.add(arg)
+        else:
+            values |= _literal_values(arg)
+    return values
+
+
+def test_standard_is_the_pinned_sdk_literal_for_the_interactions_api():
+    request_tiers = _literal_values(
+        typing.get_type_hints(BaseCreateModelInteractionParams)["service_tier"]
+    )
+    response_tiers = _literal_values(
+        Interaction.model_fields["service_tier"].annotation
+    )
+
+    assert STANDARD_TIER in request_tiers
+    assert request_tiers == response_tiers == {"flex", "standard", "priority"}
+    assert (
+        SERVICE_TIERS_BY_RUNTIME_PAIR[("google-genai", "interactions")] == request_tiers
+    )
+
+
+@pytest.mark.parametrize("config_id", PATH_PROFILES)
+def test_path_profile_requests_the_standard_tier(config_id):
+    config = get_model_config(config_id)
+
+    assert (config["runtime"]["sdk"], config["runtime"]["api"]) == (
+        "google-genai",
+        "interactions",
+    )
+    assert config["request"]["service_tier"] == STANDARD_TIER
+
+
+def test_every_gemini_high_profile_requests_the_standard_tier():
+    high = [
+        entry
+        for entry in load_model_configs()
+        if entry["id"].startswith("google-gemini-3-8-flash-high")
+    ]
+
+    assert sorted(entry["id"] for entry in high) == sorted(PATH_PROFILES)
+    assert {entry["request"]["service_tier"] for entry in high} == {STANDARD_TIER}
+
+
+def test_upstream_low_profile_keeps_the_provider_default():
+    config = get_model_config("google-gemini-3-8-flash-low-provider-adapter")
+
+    assert "service_tier" not in config["request"]
+
+
+class _TierAdapter:
+    def __init__(self, reported: str | None) -> None:
+        self.reported = reported
+
+    def invoke(self, request):
+        return ModelResponse(
+            output_text="ACTION1",
+            usage=NormalizedUsage(total_tokens=5),
+            service_tier=self.reported,
+        )
+
+
+def _agent(monkeypatch, tmp_path, *, reported: str | None) -> BenchmarkingAgent:
+    config = deepcopy(get_model_config(PATH_PROFILES[0]))
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("benchmarking.agent.get_model_config", lambda _id: config)
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_client", lambda **_kwargs: object()
+    )
+    monkeypatch.setattr(
+        "benchmarking.agent.build_model_runtime_adapter",
+        lambda **_kwargs: _TierAdapter(reported),
+    )
+    return BenchmarkingAgent(
+        card_id="card-id",
+        game_id="game-id",
+        agent_name="agent-name",
+        ROOT_URL="https://arcprize.org",
+        record=False,
+        arc_env=SimpleNamespace(info=SimpleNamespace(baseline_actions=[])),
+        config=config["id"],
+    )
+
+
+def _frame() -> FrameData:
+    return FrameData(
+        frame=[[[0, 1], [1, 0]]],
+        state=GameState.NOT_FINISHED,
+        levels_completed=0,
+        available_actions=[GameAction.ACTION1.value],
+    )
+
+
+def test_requested_and_served_tiers_are_recorded(monkeypatch, tmp_path):
+    agent = _agent(monkeypatch, tmp_path, reported="standard")
+
+    agent.choose_action([], _frame())
+
+    run = json.loads((Path(agent.run_dir) / "run_meta.json").read_text())
+    step = json.loads((Path(agent.run_dir) / "step_001.json").read_text())
+    assert run["requested_service_tier"] == STANDARD_TIER
+    assert step["service_tier"] == "standard"
+
+
+def test_a_different_served_tier_is_recorded_and_logged(monkeypatch, tmp_path, caplog):
+    agent = _agent(monkeypatch, tmp_path, reported="flex")
+
+    with caplog.at_level(logging.WARNING):
+        agent.choose_action([], _frame())
+
+    assert "Requested service_tier='standard' but the provider reported 'flex'" in (
+        caplog.text
+    )
+    step = json.loads((Path(agent.run_dir) / "step_001.json").read_text())
+    assert step["service_tier"] == "flex"
