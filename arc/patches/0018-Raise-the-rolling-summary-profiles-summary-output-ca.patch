+@pytest.mark.parametrize("config_id", [ROLLING_SUMMARY, NOTES_OFF])
+def test_summary_budget_equals_the_action_output_budget(config_id):
+    # At high thinking the model's reasoning counts against the summary cap.
+    # The rolling-summary profiles give the summary request the 65,536 output
+    # tokens of every action request; the Provider Adapter keeps 8,192.
+    config = get_model_config(config_id)
+    compaction = config["runtime"]["compaction"]
+    adapter_compaction = get_model_config(PROVIDER_ADAPTER)["runtime"]["compaction"]
+    budget = config["request"]["generation_config"]["max_output_tokens"]
+
+    assert budget == ACTION_OUTPUT_BUDGET == 65_536
+    assert compaction["summary_max_output_tokens"] == budget
+    assert adapter_compaction["summary_max_output_tokens"] == 8_192
+    assert {**compaction, "summary_max_output_tokens": 8_192} == adapter_compaction
+    # Configuration validation still reserves the larger summary output.
+    reserved = (
+        compaction["trigger_tokens"]
+        + compaction["summary_max_output_tokens"]
+        + compaction["summary_input_headroom_tokens"]
+    )
+    assert reserved < config["agent"]["MAX_CONTEXT_LENGTH"]
+
+
 def test_notes_off_differs_from_rolling_summary_only_in_the_flag():
